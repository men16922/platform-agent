            "values": [
              "# Low-footprint Argo Rollouts controller for local kind/k3s. Contract\n# (guard-tested): every CPU request stays \u003c= 50m so the full add-on stack fits\n# the Docker VM budget. Dashboard is enabled for the canary promote/abort demo.\ncontroller:\n  resources:\n    requests:\n      cpu: 10m\n      memory: 64Mi\n\ndashboard:\n  enabled: true\n  resources:\n    requests:\n      cpu: 5m\n      memory: 32Mi\n"
            ],
            "verify": false,
            "version": "2.41.1",
            "wait": true,
            "wait_for_jobs": false
          },
