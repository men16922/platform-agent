# macOS
.DS_Store

# Local ArgoCD demo credential — never commit. The recording script now reads the
# password from the cluster secret instead, but an older README told people to
# create this file.
.argocd-demo-password

# Skill scratch output (humanize drafts 등). 산출물은 docs/ 아래 최종본만 남긴다.
_workspace/

# Local-dev cosign keys (make sign-image). Never commit a signing key.
cosign.key
cosign.pub
.state/

# setuptools 산물 — `pip install .` 이 리포 루트에 남긴다(2026-08-30에 실제로 남았다)
build/
